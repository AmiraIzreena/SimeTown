# Copy to .env and fill in. Never commit real values.

# --- App -------------------------------------------------------------------
# development | staging | production
APP_ENV=development
# Public origin of the app. Used for the CSRF origin check and secure cookies.
APP_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# PostgreSQL 15 or newer:  postgres://user:password@host:5432/kita
# Zero-install local demo: pglite://./.data/pglite   (never in production)
DATABASE_URL=pglite://./.data/pglite
DB_POOL_MAX=10
# require | disable. Defaults to "require" when APP_ENV is staging or production.
# DB_SSL=require

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_HOURS=168
# Where to read the client IP from, for rate limits: none | cloudflare | forwarded
#   none       local development only (refused when APP_ENV is staging or production)
#   cloudflare CF-Connecting-IP; only when the origin is reachable through Cloudflare alone
#   forwarded  X-Forwarded-For, counted from the right: set TRUSTED_PROXY_HOPS to the number of
#              proxies you run in front of the app (1 for Render, Railway, Fly.io and similar)
TRUST_PROXY=none
# TRUSTED_PROXY_HOPS=1

# --- Machine-to-machine secrets (32+ random characters each) ------------------
# Scheduler token for POST /api/v1/internal/jobs/:name. Jobs endpoint is off without it.
# CRON_SECRET=
# Flood-sensor bridge token for POST /api/v1/ingest/flood. Endpoint is off without it.
# SENSOR_INGEST_TOKEN=

# --- AI photo and report checks (optional) ------------------------------------
# none = residents pick from a list and reports use keyword rules.
AI_PROVIDER=none
# AI_API_URL=
# AI_API_KEY=
# AI_MODEL=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- Demo data (npm run db:seed) ----------------------------------------------
# Password given to every demo account. If unset, the seed makes a random one and prints it.
# SEED_DEMO_PASSWORD=
