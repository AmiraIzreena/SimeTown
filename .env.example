# Copy to .env and fill in. Never commit real values.

# --- App -------------------------------------------------------------------
# development | staging | production
APP_ENV=development
# Public origin of the app. Used for the CSRF origin check and secure cookies.
APP_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# PostgreSQL 15 or newer:  postgres://user:password@host:5432/kita
# Zero-install local demo: pglite://./.data/pglite   (never in production)
DATABASE_URL=pglite://./.data/pglite
DB_POOL_MAX=10
# require | disable. Defaults to "require" when APP_ENV is staging or production.
# DB_SSL=require

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_HOURS=168
# Where to read the client IP from, for rate limits: none | cloudflare | forwarded
#   none       local development only (refused when APP_ENV is staging or production)
#   cloudflare CF-Connecting-IP; only when the origin is reachable through Cloudflare alone
#   forwarded  X-Forwarded-For, counted from the right: set TRUSTED_PROXY_HOPS to the number of
#              proxies you run in front of the app (1 for Render, Railway, Fly.io and similar)
TRUST_PROXY=none
# TRUSTED_PROXY_HOPS=1

# --- Redis (optional) ---------------------------------------------------------
# Upstash Redis over REST. When set, rate limits count in Redis and sign-in lookups are cached
# briefly; without it (or whenever Redis fails) PostgreSQL does both. Set both or neither.
# Money, the ledger, Insights and jobs never use Redis.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Seconds a sign-in lookup may be served from Redis (0 to 300; 0 turns the cache off).
# SESSION_CACHE_SECONDS=60

# --- Machine-to-machine secrets (32+ random characters each) ------------------
# Scheduler token for POST /api/v1/internal/jobs/:name. Jobs endpoint is off without it.
# CRON_SECRET=
# Flood-sensor bridge token for POST /api/v1/ingest/flood. Endpoint is off without it.
# SENSOR_INGEST_TOKEN=

# Smart parcel lockers: derives pickup PINs and QR codes (never stored). At least 32 characters;
# required in production before lockers can be used. Generate one with: openssl rand -hex 32
# LOCKER_CREDENTIAL_SECRET=

# Tamu: encrypts visitors' identity numbers (AES-256-GCM). At least 32 characters; required in
# production before the gate can record visitors. Keep it safe: changing or losing it makes stored
# numbers unreadable (they are deleted after 90 days anyway). Generate one with: openssl rand -hex 32
# VISITOR_DATA_KEY=

# --- AI photo and report checks (optional) ------------------------------------
# none = residents pick from a list and reports use keyword rules.
# anthropic or openai = one hosted vision call per photo, report or bill; if it
# fails or is slow, the same fallbacks apply. The model must read images, and a
# non-reasoning model fits the short replies (for example gpt-4.1-mini).
# A reasoning model (such as the gpt-5 family) spends hidden tokens before it
# answers: raise the output budget (2000 or more) and the timeout for it.
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=
# AI_MAX_OUTPUT_TOKENS=
# AI_TIMEOUT_SECONDS=8
# Questions each resident may ask the AI Assistant in 24 hours; after that the
# fixed rules answer until the next day.
# AI_ASSISTANT_DAILY_LIMIT=100
# Optional: the provider's own endpoint is used when this is not set.
# AI_API_URL=

# --- Banjir camera reading and agent clock (optional) --------------------------
# Drain camera photos (a CCTV stand-in in the prototype) are read by, in order:
#   1. FLOOD_MODEL_URL: your own water-level model, such as a CNN trained on
#      township CCTV frames. POST {"image": base64, "mime"} -> {"levelPct", "confidence"}.
#   2. AI_PROVIDER above: a hosted vision model.
#   3. Neither: only the labelled test pictures in the console.
# The reading is a number with a confidence; the Banjir rules decide every alert.
# FLOOD_MODEL_URL=
# FLOOD_MODEL_TOKEN=
# In local development the flood agent runs every minute by itself (the live server
# uses the flood-agent scheduled job). Set to off to stop it.
# FLOOD_DEV_CLOCK=off

# --- Google Maps (optional) --------------------------------------------------
# Enables the live Google basemap for Gerak. Enable Maps JavaScript API in
# Google Cloud and restrict this browser key to your app's HTTP referrers.
# Without it, Gerak keeps using the built-in privacy-preserving township map.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional production map ID. The Google demo map ID is used when omitted.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- Demo data (npm run db:seed) ----------------------------------------------
# Password given to every demo account. If unset, the seed makes a random one and prints it.
# SEED_DEMO_PASSWORD=

# --- Demo environment ---------------------------------------------------------
# On (the default): every screen carries one small "Demo environment" marker, and test
# tools and notes about simulated parts are shown. Set to false only for a real launch.
# NEXT_PUBLIC_DEMO_MODE=true

# Email (optional). SimeTown sends parcel emails from this account. Gmail: turn on 2-Step Verification,
# create an App Password (Google Account > Security > App passwords) and paste it as SMTP_PASS. Never commit it.
# Without these, emails wait in the outbox and are not sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_FROM=you@gmail.com
