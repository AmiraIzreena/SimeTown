index 0000000..15c6139
--- /dev/null
+++ b/src/server/modules/parking/service.ts
@@ -0,0 +1,218 @@
+import { createHash } from 'node:crypto';
+import { one, type Db } from '../../db/client';
+import { requireVerifiedResident, type Actor } from '../../auth/actor';
+import { conflict, notFound, ruleViolation } from '../../errors';
+import { audit } from '../audit';
+import { randomCode } from '../identity/service';
+import { getSettings, todayIn } from '../settings';
+import { resolveTownship } from '../townships';
+
+/**
+ * Guided parking (the brief's "prebooked parking"), for the township's busy
+ * places: the park at weekends, the community hall on event days, the masjid on
+ * Friday. Drivers see which car park has room and are sent there, or book one of
+ * the free bays held back for booking.
+ *
+ * There are no bay sensors yet, so occupancy is SIMULATED from the time of day,
+ * the day of the week and the car park, and always labelled as such. What is
+ * real is the measurement the brief asks for: residents time how long it takes
+ * to find a bay, with guidance and without, and staff compare the two.
+ */
+
+export const PARKING_SLOTS = ['MORNING', 'AFTERNOON', 'EVENING'] as const;
+export type ParkingSlot = (typeof PARKING_SLOTS)[number];
+const BOOK_AHEAD_DAYS = 7;
+/** A search left open longer than this is treated as abandoned and left out of the averages. */
+const MAX_SEARCH_MINUTES = 60;
+
+/** Busy-ness by hour in the township's timezone, weekend evenings busiest. Deterministic for each 15 minutes. */
+export function simulatedOccupancy(areaId: string, at: Date, tz: string): number {
+  const parts = new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(at);
+  const hour = Number(parts.find((p) => p.type === 'hour')!.value);
+  const minute = Number(parts.find((p) => p.type === 'minute')!.value);
+  const weekday = parts.find((p) => p.type === 'weekday')!.value;
+  const weekend = weekday === 'Sat' || weekday === 'Sun';
+  const curve = [0.1, 0.08, 0.06, 0.05, 0.05, 0.08, 0.2, 0.35, 0.45, 0.5, 0.55, 0.6, 0.65, 0.6, 0.55, 0.55, 0.6, 0.7, 0.8, 0.85, 0.75, 0.55, 0.35, 0.2];
+  const friday = weekday === 'Fri' && hour >= 12 && hour <= 14 ? 0.2 : 0;
+  const bucket = `${areaId}:${Math.floor((hour * 60 + minute) / 15)}:${weekday}`;
+  const jitter = (createHash('sha256').update(bucket).digest()[0]! / 255 - 0.5) * 0.3;
+  const areaBias = (createHash('sha256').update(areaId).digest()[0]! / 255 - 0.5) * 0.3;
+  return Math.min(0.98, Math.max(0.03, curve[hour]! + (weekend ? 0.15 : 0) + friday + jitter + areaBias));
+}
+
+const slotOf = (hour: number): ParkingSlot => (hour < 12 ? 'MORNING' : hour < 18 ? 'AFTERNOON' : 'EVENING');
+
+interface AreaRow {
+  id: string;
+  place: string;
+  name: string;
+  total_bays: number;
+  bookable_bays: number;
+  lat: number | null;
+  lng: number | null;
+  booked_now: number;
+}
+
+/** Every place with its car parks, how full each looks now, and where to go. */
+export async function parkingOverview(db: Db, actor: Actor, now: Date) {
+  const resident = requireVerifiedResident(actor);
+  const tz = (await getSettings(db)).timezone;
+  const today = await todayIn(db, now);
+  const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: 'numeric', hourCycle: 'h23' }).format(now));
+  const slot = slotOf(hour);
+  const areas = await db.query<AreaRow>(
+    `SELECT a.id, a.place, a.name, a.total_bays, a.bookable_bays, a.lat, a.lng,
+            (SELECT count(*)::int FROM parking_bookings b WHERE b.area_id = a.id AND b.status = 'BOOKED' AND b.day = $2::date AND b.slot = $3) AS booked_now
+       FROM parking_areas a WHERE a.township_id = $1 AND a.active ORDER BY a.place, a.name`,
+    [resident.townshipId, today, slot],
+  );
+  const places = new Map<string, ReturnType<typeof view>[]>();
+  function view(a: AreaRow) {
+    const open = a.total_bays - a.bookable_bays;
+    const occupancy = simulatedOccupancy(a.id, now, tz);
+    const free = Math.max(0, Math.round(open * (1 - occupancy)));
+    return {
+      id: a.id, name: a.name, totalBays: a.total_bays, bookableBays: a.bookable_bays, lat: a.lat, lng: a.lng,
+      occupancyPct: Math.round(occupancy * 100),
+      freeBays: free,
+      bookableLeftNow: Math.max(0, a.bookable_bays - a.booked_now),
+      level: occupancy >= 0.9 ? 'FULL' : occupancy >= 0.7 ? 'BUSY' : 'OK',
+    };
+  }
+  for (const a of areas) places.set(a.place, [...(places.get(a.place) ?? []), view(a)]);
+  return {
+    simulated: true,
+    slot,
+    places: [...places.entries()].map(([place, list]) => {
+      const best = [...list].sort((x, y) => y.freeBays - x.freeBays)[0] ?? null;
+      return { place, areas: list, bestAreaId: best && best.freeBays > 0 ? best.id : null };
+    }),
+  };
+}
+
+export interface BookingInput {
+  areaId: string;
+  day: string;
+  slot: ParkingSlot;
+  vehicleNo: string;
+}
+
+/** Book one of the free bays held back at a car park. One booking per person per place and time. */
+export async function bookBay(db: Db, actor: Actor, input: BookingInput, now: Date) {
+  const resident = requireVerifiedResident(actor);
+  return db.tx(async (tx) => {
+    const area = await one<{ id: string; place: string; name: string; bookable_bays: number }>(
+      tx, 'SELECT id, place, name, bookable_bays FROM parking_areas WHERE id = $1 AND township_id = $2 AND active FOR UPDATE', [input.areaId, resident.townshipId],
+    );
+    if (!area) throw notFound('Car park');
+    if (area.bookable_bays === 0) throw ruleViolation('NOT_BOOKABLE', 'This car park has no bays to book. Use guidance instead.');
+    const today = await todayIn(tx, now);
+    const range = await one<{ ok: boolean }>(tx, `SELECT $1::date >= $2::date AND $1::date <= $2::date + $3::int AS ok`, [input.day, today, BOOK_AHEAD_DAYS]);
+    if (!range!.ok) throw ruleViolation('PARKING_DAY', `Choose a day from today up to ${BOOK_AHEAD_DAYS} days ahead.`);
+    const mine = await one(
+      tx,
+      `SELECT 1 FROM parking_bookings b JOIN parking_areas a ON a.id = b.area_id
+        WHERE b.user_id = $1 AND b.status = 'BOOKED' AND b.day = $2::date AND b.slot = $3 AND a.place = $4`,
+      [resident.id, input.day, input.slot, area.place],
+    );
+    if (mine) throw conflict('ALREADY_BOOKED', 'You already have a bay booked there at that time.');
+    const taken = await one<{ n: number }>(tx, `SELECT count(*)::int AS n FROM parking_bookings WHERE area_id = $1 AND status = 'BOOKED' AND day = $2::date AND slot = $3`, [area.id, input.day, input.slot]);
+    if (taken!.n >= area.bookable_bays) throw ruleViolation('PARKING_FULL', 'Every bookable bay is taken then. Try another car park or time.');
+    const code = `B${randomCode(5)}`;
+    const row = await one<{ id: string }>(
+      tx,
+      `INSERT INTO parking_bookings (area_id, user_id, day, slot, vehicle_no, code, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING id`,
+      [area.id, resident.id, input.day, input.slot, input.vehicleNo.trim().toUpperCase(), code, now],
+    );
+    return { id: row!.id, code, place: area.place, area: area.name };
+  });
+}
+
+export async function myParkingBookings(db: Db, actor: Actor, now: Date) {
+  const resident = requireVerifiedResident(actor);
+  return db.query(
+    `SELECT b.id, b.day::text AS day, b.slot, b.vehicle_no, b.code, b.status, a.place, a.name AS area, a.lat, a.lng
+       FROM parking_bookings b JOIN parking_areas a ON a.id = b.area_id
+      WHERE b.user_id = $1 AND b.day >= $2::date ORDER BY b.day, b.slot LIMIT 20`,
+    [resident.id, await todayIn(db, now)],
+  );
+}
+
+export async function cancelParkingBooking(db: Db, actor: Actor, id: string) {
+  const resident = requireVerifiedResident(actor);
+  const rows = await db.query(`UPDATE parking_bookings SET status = 'CANCELLED' WHERE id = $1 AND user_id = $2 AND status = 'BOOKED' RETURNING id`, [id, resident.id]);
+  if (rows.length === 0) throw notFound('Booking');
+  return { ok: true };
+}
+
+/** Starts the clock on finding a bay, with guidance to a car park or without. */
+export async function startSearch(db: Db, actor: Actor, input: { place: string; areaId?: string; guided: boolean }, now: Date) {
+  const resident = requireVerifiedResident(actor);
+  if (input.areaId && !(await one(db, 'SELECT 1 FROM parking_areas WHERE id = $1 AND township_id = $2 AND place = $3', [input.areaId, resident.townshipId, input.place]))) {
+    throw notFound('Car park');
+  }
+  // Only one search runs at a time: starting again drops the one left open.
+  await db.query('DELETE FROM parking_searches WHERE user_id = $1 AND parked_at IS NULL', [resident.id]);
+  const row = await one<{ id: string }>(
+    db,
+    'INSERT INTO parking_searches (township_id, user_id, place, area_id, guided, started_at) VALUES ($1, $2, $3, $4, $5, $6) RETURNING id',
+    [resident.townshipId, resident.id, input.place, input.areaId ?? null, input.guided, now],
+  );
+  return { id: row!.id };
+}
+
+export async function finishSearch(db: Db, actor: Actor, id: string, now: Date) {
+  const resident = requireVerifiedResident(actor);
+  const row = await one<{ started_at: Date }>(
+    db, `UPDATE parking_searches SET parked_at = $3 WHERE id = $1 AND user_id = $2 AND parked_at IS NULL RETURNING started_at`, [id, resident.id, now],
+  );
+  if (!row) throw notFound('Search');
+  return { minutes: Math.round(((now.getTime() - row.started_at.getTime()) / 60_000) * 10) / 10 };
+}
+
+/** The brief's test: time spent finding a bay, guided against unguided, per place. */
+export async function parkingStats(db: Db, actor: Actor, now: Date) {
+  const rows = await db.query<{ place: string; guided: boolean; searches: number; avg_min: number | null }>(
+    `SELECT place, guided, count(*)::int AS searches,
+            round(avg(extract(epoch FROM parked_at - started_at) / 60)::numeric, 1)::float AS avg_min
+       FROM parking_searches
+      WHERE ($1::uuid IS NULL OR township_id = $1) AND parked_at IS NOT NULL AND started_at > $2::timestamptz - interval '90 days'
+        AND parked_at - started_at <= make_interval(mins => $3)
+      GROUP BY place, guided ORDER BY place`,
+    [actor.townshipId, now, MAX_SEARCH_MINUTES],
+  );
+  const areas = await db.query(
+    `SELECT a.id, a.place, a.name, a.total_bays, a.bookable_bays, a.active,
+            (SELECT count(*)::int FROM parking_bookings b WHERE b.area_id = a.id AND b.status = 'BOOKED' AND b.day >= $2::date AND b.day < $2::date + 7) AS booked_week
+       FROM parking_areas a WHERE ($1::uuid IS NULL OR a.township_id = $1) ORDER BY a.place, a.name`,
+    [actor.townshipId, await todayIn(db, now)],
+  );
+  const places = [...new Set(rows.map((r) => r.place))].map((place) => {
+    const g = rows.find((r) => r.place === place && r.guided);
+    const u = rows.find((r) => r.place === place && !r.guided);
+    return {
+      place,
+      guided: { searches: g?.searches ?? 0, avgMinutes: g?.avg_min ?? null },
+      unguided: { searches: u?.searches ?? 0, avgMinutes: u?.avg_min ?? null },
+      savedMinutes: g?.avg_min != null && u?.avg_min != null ? Math.round((u.avg_min - g.avg_min) * 10) / 10 : null,
+    };
+  });
+  return { places, areas };
+}
+
+export async function createParkingArea(db: Db, actor: Actor, input: { place: string; name: string; totalBays: number; bookableBays: number; lat?: number; lng?: number }) {
+  if (input.bookableBays > input.totalBays) throw ruleViolation('TOO_MANY_BOOKABLE', 'Bookable bays cannot be more than the total.');
+  return db.tx(async (tx) => {
+    const townshipId = await resolveTownship(tx, actor);
+    if (await one(tx, 'SELECT 1 FROM parking_areas WHERE township_id = $1 AND lower(place) = lower($2) AND lower(name) = lower($3)', [townshipId, input.place, input.name])) {
+      throw conflict('AREA_EXISTS', 'This car park already exists.');
+    }
+    const row = await one<{ id: string }>(
+      tx,
+      `INSERT INTO parking_areas (township_id, place, name, total_bays, bookable_bays, lat, lng) VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING id`,
+      [townshipId, input.place.trim(), input.name.trim(), input.totalBays, input.bookableBays, input.lat ?? null, input.lng ?? null],
+    );
+    await audit(tx, actor.id, 'PARKING_AREA_CREATED', 'parking_area', row!.id, { place: input.place, name: input.name });
+    return { id: row!.id };
+  });
+}
