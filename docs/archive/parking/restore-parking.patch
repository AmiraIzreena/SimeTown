+      setOpen(false);
+      void stats.mutate();
+    },
+  });
+  const submit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    const form = new FormData(event.currentTarget);
+    const num = (name: string) => (String(form.get(name) ?? '').trim() === '' ? undefined : Number(form.get(name)));
+    void create.run({
+      place: String(form.get('place') ?? '').trim(),
+      name: String(form.get('name') ?? '').trim(),
+      totalBays: num('totalBays'),
+      bookableBays: num('bookableBays') ?? 0,
+      lat: num('lat'),
+      lng: num('lng'),
+    });
+  };
+
+  return (
+    <>
+      <PageHeader
+        title="Parking"
+        description="Busy car parks residents can be guided to, the free bays held back for booking, and the brief’s test: minutes to find a bay with guidance and without. Occupancy is simulated until bay sensors are installed."
+        action={<Button onClick={() => setOpen(true)}><Plus className="size-4" aria-hidden /><Text>Add a car park</Text></Button>}
+      />
+      <Async state={stats} skeleton={<SkeletonList rows={3} />}>
+        {(s) => (
+          <div className="space-y-6">
+            <Card>
+              <CardHeader title="Time to find a bay" description="Average minutes, last 90 days, from residents who timed their search." />
+              {s.places.length === 0 ? (
+                <div className="p-5"><EmptyState icon={Timer} title="No timed searches yet"><Text>Residents time a search from the Parking page, with or without guidance.</Text></EmptyState></div>
+              ) : (
+                <ul className="divide-y divide-ink-100">
+                  {s.places.map((p) => (
+                    <li key={p.place} className="grid gap-2 px-5 py-4 sm:grid-cols-[1fr_auto_auto_auto] sm:items-center sm:gap-6">
+                      <span className="text-[15px] font-semibold text-ink-900">{p.place}</span>
+                      <span className="text-sm text-ink-600"><Text>{p.guided.avgMinutes != null ? `Guided: ${p.guided.avgMinutes} min (${p.guided.searches})` : 'Guided: no data'}</Text></span>
+                      <span className="text-sm text-ink-600"><Text>{p.unguided.avgMinutes != null ? `Unguided: ${p.unguided.avgMinutes} min (${p.unguided.searches})` : 'Unguided: no data'}</Text></span>
+                      <span className="text-sm font-semibold text-success-700"><Text>{p.savedMinutes != null ? `${p.savedMinutes} min saved` : '–'}</Text></span>
+                    </li>
+                  ))}
+                </ul>
+              )}
+            </Card>
+            <Card>
+              <CardHeader title="Car parks" description="Bookable bays are held back from the open bays." />
+              {s.areas.length === 0 ? (
+                <div className="p-5"><EmptyState icon={SquareParking} title="No car parks yet" /></div>
+              ) : (
+                <ul className="divide-y divide-ink-100">
+                  {s.areas.map((a) => (
+                    <li key={a.id} className="flex flex-wrap items-center justify-between gap-3 px-5 py-3">
+                      <span className="text-[15px] font-semibold text-ink-900">{a.place} <span className="font-normal text-ink-500">· {a.name}</span></span>
+                      <span className="text-sm text-ink-600"><Text>{`${a.total_bays} bays · ${a.bookable_bays} bookable · ${a.booked_week} booked this week`}</Text></span>
+                    </li>
+                  ))}
+                </ul>
+              )}
+            </Card>
+          </div>
+        )}
+      </Async>
+      <Modal
+        open={open}
+        onClose={() => setOpen(false)}
+        title="Add a car park"
+        description="A car park at a place that gets busy, such as the park, the community hall or the masjid."
+        footer={<><Button variant="secondary" onClick={() => setOpen(false)}><Text>Cancel</Text></Button><Button type="submit" form="new-car-park" pending={create.pending}><Text>Add</Text></Button></>}
+      >
+        <form method="post" id="new-car-park" onSubmit={submit} className="space-y-4" noValidate>
+          <div className="grid gap-3 sm:grid-cols-2">
+            <Input label="Place" name="place" maxLength={80} placeholder="e.g. Elmina Central Park" required error={create.fields.place} />
+            <Input label="Car park name" name="name" maxLength={80} placeholder="e.g. North car park" required error={create.fields.name} />
+            <Input label="Total bays" name="totalBays" type="number" min={1} max={5000} required error={create.fields.totalBays} />
+            <Input label="Bookable bays" name="bookableBays" type="number" min={0} max={5000} defaultValue={0} error={create.fields.bookableBays} />
+            <Input label="Latitude (optional)" name="lat" type="number" step="any" />
+            <Input label="Longitude (optional)" name="lng" type="number" step="any" />
+          </div>
+        </form>
+      </Modal>
+    </>
+  );
+}
