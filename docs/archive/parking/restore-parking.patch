+import { useAction, useApi } from '@/lib/hooks';
+
+interface ParkingStats {
+  places: {
+    place: string;
+    guided: { searches: number; avgMinutes: number | null };
+    unguided: { searches: number; avgMinutes: number | null };
+    savedMinutes: number | null;
+  }[];
+  areas: { id: string; place: string; name: string; total_bays: number; bookable_bays: number; active: boolean; booked_week: number }[];
+}
+
+export default function ParkingConsolePage() {
+  const stats = useApi<ParkingStats>('/admin/parking');
+  const [open, setOpen] = useState(false);
+  const create = useAction((body: Record<string, unknown>) => api.post('/admin/parking/areas', body), {
+    success: 'Car park added.',
