+import { z } from 'zod';
+import { STAFF } from '@/shared/domain';
+import { emptyBody, route, zId, zText } from '../../http/router';
+import * as parking from './service';
+
+const zVehicle = z.string().trim().min(2).max(12).regex(/^[A-Za-z0-9 ]+$/, 'Letters and numbers only.');
+
+export const parkingRoutes = [
+  route({
+    method: 'GET', path: '/parking', tag: 'Parking', summary: 'Busy places, how full each car park looks now (simulated) and where to go', auth: 'session', roles: ['RESIDENT'],
+    handler: (c) => parking.parkingOverview(c.db, c.actor, c.now),
+  }),
+  route({
+    method: 'GET', path: '/parking/bookings', tag: 'Parking', summary: 'My upcoming bay bookings', auth: 'session', roles: ['RESIDENT'],
+    handler: (c) => parking.myParkingBookings(c.db, c.actor, c.now),
+  }),
+  route({
+    method: 'POST', path: '/parking/bookings', tag: 'Parking', summary: 'Book a free bay held back for booking', auth: 'session', roles: ['RESIDENT'],
+    rateLimit: { limit: 20, windowSec: 3600, by: 'user' },
+    body: z.object({ areaId: zId, day: z.string().regex(/^\d{4}-\d{2}-\d{2}$/, 'Choose a day.'), slot: z.enum(parking.PARKING_SLOTS), vehicleNo: zVehicle }),
+    handler: (c) => parking.bookBay(c.db, c.actor, c.body, c.now),
+  }),
+  route({
+    method: 'POST', path: '/parking/bookings/:bookingId/cancel', tag: 'Parking', summary: 'Cancel a bay booking', auth: 'session', roles: ['RESIDENT'], body: emptyBody,
+    handler: (c) => parking.cancelParkingBooking(c.db, c.actor, c.params.bookingId!),
+  }),
+  route({
+    method: 'POST', path: '/parking/searches', tag: 'Parking', summary: 'Start timing a search for a bay, guided to a car park or not', auth: 'session', roles: ['RESIDENT'],
+    rateLimit: { limit: 30, windowSec: 3600, by: 'user' },
+    body: z.object({ place: zText(80, 2), areaId: zId.optional(), guided: z.boolean() }),
+    handler: (c) => parking.startSearch(c.db, c.actor, c.body, c.now),
+  }),
+  route({
+    method: 'POST', path: '/parking/searches/:searchId/parked', tag: 'Parking', summary: 'Stop the clock: parked', auth: 'session', roles: ['RESIDENT'], body: emptyBody,
+    handler: (c) => parking.finishSearch(c.db, c.actor, c.params.searchId!, c.now),
+  }),
+  route({
+    method: 'GET', path: '/admin/parking', tag: 'Parking', summary: 'Car parks, bookings this week, and minutes to find a bay with and without guidance', auth: 'session', roles: STAFF,
+    handler: (c) => parking.parkingStats(c.db, c.actor, c.now),
+  }),
+  route({
+    method: 'POST', path: '/admin/parking/areas', tag: 'Parking', summary: 'Add a car park at a busy place', auth: 'session', roles: STAFF,
+    body: z.object({
+      place: zText(80, 2), name: zText(80, 2), totalBays: z.number().int().min(1).max(5000), bookableBays: z.number().int().min(0).max(5000),
+      lat: z.number().min(-90).max(90).optional(), lng: z.number().min(-180).max(180).optional(),
+    }),
+    handler: (c) => parking.createParkingArea(c.db, c.actor, c.body),
+  }),
+];
