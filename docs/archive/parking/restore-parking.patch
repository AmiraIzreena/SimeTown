+      <BookBay target={booking} onClose={() => setBooking(null)} onBooked={() => void bookings.mutate()} />
+    </>
+  );
+}
+
+/** The clock runs from "Guide me" (or "Time my search") until the driver taps "I have parked". */
+function SearchTimer({ search, pending, onParked, onStop }: { search: { place: string; area: string | null; guided: boolean; started: number }; pending: boolean; onParked: () => void; onStop: () => void }) {
+  const [now, setNow] = useState(() => Date.now());
+  useEffect(() => {
+    const timer = setInterval(() => setNow(Date.now()), 1000);
+    return () => clearInterval(timer);
+  }, []);
+  const seconds = Math.max(0, Math.floor((now - search.started) / 1000));
+  return (
+    <Card className="flex flex-wrap items-center justify-between gap-4 border-brand-300 bg-brand-50 p-5" aria-live="polite">
+      <div>
+        <p className="font-display text-lg font-bold text-ink-900">
+          <Text>{search.guided && search.area ? `Heading to ${search.area}` : `Finding a bay at ${search.place}`}</Text>
+        </p>
+        <p className="text-sm text-ink-600"><Text>Tap the button once you have parked. Only when it is safe: never while driving.</Text></p>
+      </div>
+      <div className="flex items-center gap-3">
+        <span className="parcel-code text-2xl font-bold text-brand-800">{Math.floor(seconds / 60)}:{String(seconds % 60).padStart(2, '0')}</span>
+        <Button onClick={onParked} pending={pending}><CircleParking className="size-4" aria-hidden /><Text>I have parked</Text></Button>
+        <Button variant="ghost" size="sm" onClick={onStop} aria-label="Stop timing"><X className="size-4" aria-hidden /></Button>
+      </div>
+    </Card>
+  );
+}
+
+function BookBay({ target, onClose, onBooked }: { target: { place: string; areas: Area[] } | null; onClose: () => void; onBooked: () => void }) {
+  const book = useAction((body: Record<string, unknown>) => api.post<{ code: string; area: string }>('/parking/bookings', body), {
+    success: (r) => `Booked at ${r.area}. Your code is ${r.code}.`,
+    onSuccess: () => {
+      onBooked();
+      onClose();
+    },
+  });
+  const submit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    const form = new FormData(event.currentTarget);
+    void book.run({ areaId: form.get('areaId'), day: form.get('day'), slot: form.get('slot'), vehicleNo: String(form.get('vehicleNo') ?? '').trim() });
+  };
+  return (
+    <Modal
+      open={target !== null}
+      onClose={onClose}
+      title={target ? `Book a bay at ${target.place}` : ''}
+      description="Free. One booking per person for each place and time."
+      footer={<><Button variant="secondary" onClick={onClose}><Text>Cancel</Text></Button><Button type="submit" form="book-bay" pending={book.pending}><Text>Book</Text></Button></>}
+    >
+      {target && (
+        <form method="post" id="book-bay" onSubmit={submit} className="space-y-4" noValidate>
+          <Select label="Car park" name="areaId" defaultValue={target.areas[0]?.id} error={book.fields.areaId}>
+            {target.areas.map((a) => <option key={a.id} value={a.id}>{a.name}</option>)}
+          </Select>
+          <div className="grid gap-3 sm:grid-cols-2">
+            <Input label="Day" name="day" type="date" min={today()} defaultValue={today()} required error={book.fields.day} />
+            <Select label="Time" name="slot" defaultValue="MORNING">
+              {(Object.keys(SLOTS) as Slot[]).map((s) => <option key={s} value={s}><Text>{SLOTS[s]}</Text></option>)}
+            </Select>
+          </div>
+          <Input label="Vehicle number" name="vehicleNo" maxLength={12} autoCapitalize="characters" placeholder="e.g. WXY 1234" required error={book.fields.vehicleNo} />
+        </form>
+      )}
+    </Modal>
+  );
+}
