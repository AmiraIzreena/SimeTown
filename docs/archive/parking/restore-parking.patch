+
+type Slot = 'MORNING' | 'AFTERNOON' | 'EVENING';
+interface Area {
+  id: string;
+  name: string;
+  totalBays: number;
+  bookableBays: number;
+  lat: number | null;
+  lng: number | null;
+  occupancyPct: number;
+  freeBays: number;
+  bookableLeftNow: number;
+  level: 'OK' | 'BUSY' | 'FULL';
+}
+interface Overview {
+  simulated: true;
+  slot: Slot;
+  places: { place: string; areas: Area[]; bestAreaId: string | null }[];
+}
+interface Booking {
+  id: string;
+  day: string;
+  slot: Slot;
+  vehicle_no: string;
+  code: string;
+  status: 'BOOKED' | 'CANCELLED';
+  place: string;
+  area: string;
+}
+
+const SLOTS: Record<Slot, string> = { MORNING: 'Morning (before 12 pm)', AFTERNOON: 'Afternoon (12 to 6 pm)', EVENING: 'Evening (after 6 pm)' };
+const LEVEL = {
+  OK: { label: 'Space', bar: 'bg-success-600', tone: 'success' as const },
+  BUSY: { label: 'Busy', bar: 'bg-gold-500', tone: 'gold' as const },
+  FULL: { label: 'Nearly full', bar: 'bg-accent-600', tone: 'danger' as const },
+};
+const today = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kuala_Lumpur' }).format(new Date());
+
+export default function ParkingPage() {
+  const overview = useApi<Overview>('/parking', { refreshInterval: 60_000 });
