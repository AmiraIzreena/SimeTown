+  const [search, setSearch] = useState<{ id: string; place: string; area: string | null; guided: boolean; started: number } | null>(null);
+  const [booking, setBooking] = useState<{ place: string; areas: Area[] } | null>(null);
+
+  const start = useAction(
+    async (place: string, area: Area | null, guided: boolean) => {
+      const r = await api.post<{ id: string }>('/parking/searches', { place, areaId: area?.id, guided });
+      return { ...r, place, area: area?.name ?? null, guided };
+    },
+    {
+      onSuccess: (r) => {
+        setSearch({ ...r, started: Date.now() });
+      },
+    },
+  );
+  const parked = useAction((id: string) => api.post<{ minutes: number }>(`/parking/searches/${id}/parked`), {
+    success: (r) => `Parked in ${r.minutes} min. Thank you: this helps the township plan parking.`,
+    onSuccess: () => setSearch(null),
+  });
+  const cancel = useAction((id: string) => api.post(`/parking/bookings/${id}/cancel`), { success: 'Booking cancelled.', onSuccess: () => void bookings.mutate() });
+
+  const guide = (place: string, area: Area) => {
+    void start.run(place, area, true);
+    if (area.lat !== null && area.lng !== null) {
+      window.open(`https://www.google.com/maps/dir/?api=1&destination=${area.lat},${area.lng}&travelmode=driving`, '_blank', 'noopener');
+    }
+  };
+
+  return (
+    <>
+      <PageHeader
+        title="Parking"
+        description="Going to the park, the community hall or the masjid at a busy time? See which car park has room and go straight there, or book one of the free bays held back for booking."
+      />
+      <div className="space-y-6">
+        {search && <SearchTimer search={search} pending={parked.pending} onParked={() => void parked.run(search.id)} onStop={() => setSearch(null)} />}
+
+        <Async state={overview} skeleton={<SkeletonList rows={3} />}>
+          {(o) =>
+            o.places.length === 0 ? (
+              <EmptyState icon={CircleParking} title="No car parks set up yet"><Text>The township team adds the busy car parks here.</Text></EmptyState>
+            ) : (
+              <>
+                <p className="rounded-md bg-ink-50 px-4 py-2.5 text-sm text-ink-600"><Text>How full each car park is, is simulated from the time and day until bay sensors are installed. Bookings and timings are real.</Text></p>
+                {o.places.map((p) => (
+                  <Card key={p.place}>
+                    <CardHeader
+                      title={p.place}
+                      description={p.bestAreaId ? `Go to ${p.areas.find((a) => a.id === p.bestAreaId)!.name}: it has the most space now.` : 'Every car park here looks full now. Book a bay or come later.'}
+                      action={p.areas.some((a) => a.bookableBays > 0) ? <Button size="sm" variant="secondary" onClick={() => setBooking({ place: p.place, areas: p.areas.filter((a) => a.bookableBays > 0) })}><CalendarPlus className="size-4" aria-hidden /><Text>Book a bay</Text></Button> : undefined}
+                    />
+                    <ul className="divide-y divide-ink-100">
+                      {p.areas.map((a) => (
+                        <li key={a.id} className={cn('grid gap-3 px-5 py-4 sm:grid-cols-[1fr_auto] sm:items-center', a.id === p.bestAreaId && 'bg-success-50/60')}>
+                          <div className="min-w-0 space-y-2">
+                            <div className="flex flex-wrap items-center gap-2">
+                              <span className="text-[15px] font-semibold text-ink-900">{a.name}</span>
+                              <Badge tone={LEVEL[a.level].tone}><Text>{LEVEL[a.level].label}</Text></Badge>
+                              {a.id === p.bestAreaId && <Badge tone="success"><Text>Best now</Text></Badge>}
+                            </div>
+                            <LocalizedDiv className="occupancy-bar" role="img" aria-label={`${a.occupancyPct}% full`}>
+                              <span className={LEVEL[a.level].bar} style={{ width: `${a.occupancyPct}%` }} />
+                            </LocalizedDiv>
+                            <p className="text-sm text-ink-500">
+                              <Text>{`About ${a.freeBays} free of ${a.totalBays - a.bookableBays}`}</Text>
+                              {a.bookableBays > 0 && <> · <Text>{`${a.bookableLeftNow} of ${a.bookableBays} bookable bays left now`}</Text></>}
+                            </p>
+                          </div>
+                          <Button size="sm" variant={a.id === p.bestAreaId ? 'primary' : 'secondary'} onClick={() => guide(p.place, a)} disabled={start.pending || search !== null}>
+                            <Navigation className="size-4" aria-hidden /><Text>Guide me there</Text></Button>
+                        </li>
+                      ))}
+                    </ul>
+                    <div className="border-t border-ink-100 px-5 py-3">
